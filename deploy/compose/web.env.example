# Rendered by scripts/render-config.py to .rendered/deploy/compose/web.env.
# Copied to /opt/washburn/compose/web.env (mode 0600) by scripts/deploy.sh.
# Values are plain KEY=value: no quotes, no spaces, no $ expansion.

# Image for both the public and admin apps ([images]).
WASHBURN_IMAGE_WEB=ghcr.io/example/washburn-web:latest

# Tailscale IP of the data VM, written by deploy.sh from `tailscale ip -4 data`.
# Pins the host name "data" for extra_hosts. Deploy the data VM first.
WASHBURN_DATA_IP=100.64.0.11

# Tailnet MagicDNS suffix ([tailscale].tailnet).
WASHBURN_TAILNET=example.ts.net

# Written by deploy.sh from `tailscale ip -4` on the VM. Example value; deploy.sh overwrites it on the VM.
WASHBURN_TAILSCALE_IP=100.64.0.10

# Caddy: public site host ([domain].public_host) and ACME account email ([domain].acme_email).
WASHBURN_PUBLIC_HOST=example.com
WASHBURN_ACME_EMAIL=you@example.com

# Optional GHCR pull credentials (see crawler.env.example).
WASHBURN_GHCR_USER=
WASHBURN_GHCR_TOKEN=
