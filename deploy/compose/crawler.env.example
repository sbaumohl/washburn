# Rendered by scripts/render-config.py to .rendered/deploy/compose/crawler.env.
# Copied to /opt/washburn/compose/crawler.env (mode 0600) by scripts/deploy.sh.
# Values are plain KEY=value: no quotes, no spaces, no $ expansion.

# Image references (ghcr.io/<owner>/washburn-<name>:<tag>, from [images]).
WASHBURN_IMAGE_SWEEPER=ghcr.io/example/washburn-sweeper:latest
WASHBURN_IMAGE_JUDGE=ghcr.io/example/washburn-judge:latest

# Number of sweeper containers ([crawl].workers). Used as compose `scale`.
WASHBURN_WORKERS=2

# Tailscale IP of the data VM, written by deploy.sh from `tailscale ip -4 data`.
# Pins the host name "data" for extra_hosts. Deploy the data VM first.
WASHBURN_DATA_IP=100.64.0.11

# Tailnet MagicDNS suffix ([tailscale].tailnet), e.g. tail1234.ts.net.
WASHBURN_TAILNET=example.ts.net

# Written by deploy.sh from `tailscale ip -4` on the VM. Not used by this
# stack's services. Example value; deploy.sh overwrites it on the VM.
WASHBURN_TAILSCALE_IP=100.64.0.10

# Optional. If both are set, deploy.sh runs `docker login ghcr.io` on the VM
# (token on stdin). Read-only pull token ([images].ghcr_user / ghcr_token).
WASHBURN_GHCR_USER=
WASHBURN_GHCR_TOKEN=
