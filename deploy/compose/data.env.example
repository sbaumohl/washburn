# Rendered by scripts/render-config.py to .rendered/deploy/compose/data.env.
# Copied to /opt/washburn/compose/data.env (mode 0600) by scripts/deploy.sh.
# Values are plain KEY=value: no quotes, no spaces, no $ expansion.

# Postgres container settings ([postgres] table). Native names: the postgres image requires them.
POSTGRES_DB=washburn
POSTGRES_USER=washburn
POSTGRES_PASSWORD=dummy-password-for-config-check

# Written by deploy.sh from `tailscale ip -4` on the VM. Example value; deploy.sh overwrites it on the VM.
WASHBURN_TAILSCALE_IP=100.64.0.10

# Nightly backup OnCalendar ([hetzner].schedule). Read by deploy.sh only, which
# writes it into the installed washburn-backup.timer. Not a compose variable.
WASHBURN_BACKUP_SCHEDULE=*-*-* 03:17:00 UTC

# Optional GHCR pull credentials (see crawler.env.example). Not used by the data stack's images.
WASHBURN_GHCR_USER=
WASHBURN_GHCR_TOKEN=
