      "created": 1791427462440,
      "link": null,
      "locked": false,
      "text": "Own service, same box.\nSweepers POST findings to\nit; it enforces the judge\nconcurrency cap for all\nlocal sweepers, so no\nshared cap row is needed.",
      "fontSize": 13,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Own service, same box.\nSweepers POST findings to\nit; it enforces the judge\nconcurrency cap for all\nlocal sweepers, so no\nshared cap row is needed.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "gARMXw6tBDYJJ5jLX0ER",
      "type": "text",
      "x": 1830,
      "y": 50,
      "width": 553.28,
      "height": 52.5,
      "angle": 0,
      "strokeColor": "#495057",
