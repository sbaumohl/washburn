    {
      "id": "tzlg3tRqXZm1p-ubiPS3",
      "type": "text",
      "x": 2605,
      "y": -260,
      "width": 588.12,
      "height": 146.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 821370693,
      "version": 1,
      "versionNonce": 1573788478,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791427462440,
      "created": 1791427462440,
      "link": null,
      "locked": false,
      "text": "queue        url, host, lease_until   FOR UPDATE SKIP LOCKED\nvisited      url_hash UNIQUE          survives restarts, no re-paid model calls\nevents       Jev decisions, verdicts  = today's events.jsonl\nfindings     notes + .md reports      + reviewed_by, published flag\nheartbeats   one row per sweeper      admin reads these\nsearch       tsvector + GIN           Postgres FTS; Meilisearch only if needed\nrate_tokens  Jev global cap  (judge cap lives in the per-VM judge service)\nblobs        sha256 PK, zstd bytea     raw .body/.txt, content-addressed, deduped;\n                                      pages/<sha>.json metadata -> row pointing at blob",
      "fontSize": 13,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "queue        url, host, lease_until   FOR UPDATE SKIP LOCKED\nvisited      url_hash UNIQUE          survives restarts, no re-paid model calls\nevents       Jev decisions, verdicts  = today's events.jsonl\nfindings     notes + .md reports      + reviewed_by, published flag\nheartbeats   one row per sweeper      admin reads these\nsearch       tsvector + GIN           Postgres FTS; Meilisearch only if needed\nrate_tokens  Jev global cap  (judge cap lives in the per-VM judge service)\nblobs        sha256 PK, zstd bytea     raw .body/.txt, content-addressed, deduped;\n                                      pages/<sha>.json metadata -> row pointing at blob",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
