      "created": 1791427462440,
      "link": null,
      "locked": false,
      "text": "pg_dump -Fc | zstd  ->  borg or rsync over SSH to the Storage Box\nretain 7 daily + 4 weekly + 6 monthly;  monthly restore drill into a scratch DB\nblobs are inside the dump, so evidence and findings restore together",
      "fontSize": 13,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "pg_dump -Fc | zstd  ->  borg or rsync over SSH to the Storage Box\nretain 7 daily + 4 weekly + 6 monthly;  monthly restore drill into a scratch DB\nblobs are inside the dump, so evidence and findings restore together",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
