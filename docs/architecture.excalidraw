      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--classifier-concurrency is per-process, so\nit multiplies by N: enforce via rate_tokens\nrow in Postgres. Heartbeat row every 30s.\nCredential scrubbing stays in-process.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "82hUUWdW_Dff96oMgn84",
      "type": "text",
      "x": 2235,
      "y": -70,
      "width": 169.0,
