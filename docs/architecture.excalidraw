      "boundElements": [],
      "updated": 1791427462440,
      "created": 1791427462440,
      "link": null,
      "locked": false,
      "text": "Removed from this box: Doctor process. Judge kept here as its own service.\nHorizontal scale = clone this VM from the same OpenTofu module + cloud-init.\nPostgres queue + per-host leases coordinate; no orchestrator needed.",
      "fontSize": 14,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
